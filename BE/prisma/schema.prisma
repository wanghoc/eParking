// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int        @id @default(autoincrement())
  username   String
  mssv       String?
  email      String     @unique
  phone      String?
  password   String
  role       Role       @default(student)
  status     UserStatus @default(active)
  created_at DateTime   @default(now())

  // Relations
  vehicles     Vehicle[]
  wallet       Wallet?
  transactions Transaction[]
  system_logs  SystemLog[]

  @@map("users")
}

model Vehicle {
  id            Int         @id @default(autoincrement())
  user_id       Int
  license_plate String      @unique
  brand         String?
  model         String?
  vehicle_type  VehicleType @default(Xe_may)
  created_at    DateTime    @default(now())

  // Relations
  user             User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  parking_sessions ParkingSession[]

  @@map("vehicles")
}

model Wallet {
  id         Int      @id @default(autoincrement())
  user_id    Int      @unique
  balance    Decimal  @default(0.00) @db.Decimal(12, 2)
  updated_at DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @updatedAt @db.Timestamp(0)

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("wallet")
}

model Transaction {
  id          Int             @id @default(autoincrement())
  user_id     Int
  type        TransactionType
  method      String?         @db.VarChar(50)
  amount      Decimal
  status      String          @default("Thành công")
  description String?
  session_id  Int?            @unique
  // true khi giao dịch này đẩy số dư ví xuống dưới 0 (nợ cước)
  overdraft   Boolean         @default(false)
  created_at  DateTime        @default(now())

  // Relations
  user    User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  session ParkingSession? @relation(fields: [session_id], references: [id], onDelete: SetNull)

  @@index([user_id, created_at], map: "IX_transactions_user_created")
  @@map("transactions")
}

model PaymentMethod {
  id         Int                 @id @default(autoincrement())
  name       String
  type       String
  icon       String
  status     PaymentMethodStatus @default(active)
  created_at DateTime            @default(now())

  @@unique([name], map: "UQ_payment_methods_name")
  @@map("payment_methods")
}

model ParkingLot {
  id           Int      @id @default(autoincrement())
  name         String
  capacity     Int
  occupied     Int      @default(0)
  fee_per_turn Decimal  @default(2000.00)
  status       String   @default("Hoạt động")
  created_at   DateTime @default(now())

  // Relations
  parking_sessions ParkingSession[]
  edge_devices     EdgeDevice[]

  @@unique([name], map: "UQ_parking_lots_name")
  @@map("parking_lots")
}

model ParkingSession {
  id                 Int           @id @default(autoincrement())
  vehicle_id         Int
  lot_id             Int?
  entry_time         DateTime      @default(now())
  exit_time          DateTime?
  fee                Decimal       @default(2000.00)
  status             SessionStatus @default(IN)
  recognition_method String        @default("Tự động")
  payment_status     PaymentStatus @default(Chua_thanh_toan)

  // Edge-cloud fields: event_id là UUID do Edge sinh ra, dùng để chống ghi trùng khi retry/sync
  entry_event_id  String?     @unique
  exit_event_id   String?     @unique
  entry_device_id Int?
  exit_device_id  Int?
  entry_image_url String?
  exit_image_url  String?
  entry_source    SyncSource  @default(ONLINE)
  exit_source     SyncSource?
  // Phiên được tạo từ sự kiện RA mà không có sự kiện VÀO tương ứng (sync lệch thứ tự / mất sự kiện)
  entry_missing   Boolean     @default(false)
  closed_reason   String?
  override_by     String?
  created_at      DateTime    @default(now())

  // Relations
  vehicle      Vehicle      @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
  parking_lot  ParkingLot?  @relation(fields: [lot_id], references: [id], onDelete: SetNull)
  entry_device EdgeDevice?  @relation("EntryDevice", fields: [entry_device_id], references: [id], onDelete: SetNull)
  exit_device  EdgeDevice?  @relation("ExitDevice", fields: [exit_device_id], references: [id], onDelete: SetNull)
  transaction  Transaction?

  @@index([vehicle_id, entry_time], map: "IX_parking_sessions_vehicle_entry")
  @@index([status], map: "IX_parking_sessions_status")
  @@map("parking_sessions")
}

// Máy trạm Edge đặt tại cổng. Xác thực bằng API key (chỉ lưu SHA-256 hash).
model EdgeDevice {
  id             Int          @id @default(autoincrement())
  code           String       @unique
  name           String
  lane           LaneType     @default(BOTH)
  lot_id         Int?
  api_key_hash   String       @unique
  status         DeviceStatus @default(active)
  last_seen_at   DateTime?
  last_ip        String?
  app_version    String?
  // Số sự kiện PENDING_SYNC Edge báo cáo qua heartbeat
  pending_events Int          @default(0)
  created_at     DateTime     @default(now())
  updated_at     DateTime     @default(now()) @updatedAt

  // Relations
  parking_lot    ParkingLot?      @relation(fields: [lot_id], references: [id], onDelete: SetNull)
  entry_sessions ParkingSession[] @relation("EntryDevice")
  exit_sessions  ParkingSession[] @relation("ExitDevice")
  events         EdgeEvent[]
  alerts         Alert[]

  @@map("edge_devices")
}

// Sổ cái idempotency: mỗi sự kiện Edge đã được xử lý thành công chỉ được ghi 1 lần.
model EdgeEvent {
  event_id    String        @id
  device_id   Int
  type        EdgeEventType
  plate       String
  event_time  DateTime
  mode        EventMode
  result_code String
  session_id  Int?
  result      Json?
  received_at DateTime      @default(now())

  device EdgeDevice @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@index([device_id, received_at], map: "IX_edge_events_device_received")
  @@map("edge_events")
}

model Alert {
  id         Int      @id @default(autoincrement())
  device_id  Int?
  type       String
  message    String?
  priority   Priority @default(Trung_binh)
  created_at DateTime @default(now())

  // Relations
  device EdgeDevice? @relation(fields: [device_id], references: [id], onDelete: SetNull)

  @@map("alerts")
}

model SystemLog {
  id         Int      @id @default(autoincrement())
  action     String
  user_id    Int?
  type       LogType  @default(Other)
  created_at DateTime @default(now())

  // Relations
  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@map("system_logs")
}

model SystemSetting {
  id            Int         @id @default(autoincrement())
  setting_key   String      @unique
  setting_value String
  setting_type  SettingType @default(string)
  description   String?
  created_at    DateTime    @default(now())
  updated_at    DateTime    @default(now()) @updatedAt

  @@map("system_settings")
}

// Enums
enum Role {
  student
  admin
}

enum UserStatus {
  active
  inactive
}

enum VehicleType {
  Xe_may @map("Xe máy")
}

enum TransactionType {
  TOPUP
  FEE
  REFUND
}

enum PaymentMethodStatus {
  active
  inactive
}

enum SessionStatus {
  IN
  OUT
}

enum PaymentStatus {
  Chua_thanh_toan @map("Chưa thanh toán")
  Da_thanh_toan   @map("Đã thanh toán")
  Hoan_tien       @map("Hoàn tiền")
}

enum LaneType {
  IN
  OUT
  BOTH
}

enum DeviceStatus {
  active
  revoked
}

enum EdgeEventType {
  CHECK_IN
  CHECK_OUT
}

enum EventMode {
  ONLINE
  SYNC
}

enum SyncSource {
  ONLINE
  OFFLINE_SYNC
  MANUAL
}

enum Priority {
  Cao        @map("Cao")
  Trung_binh @map("Trung bình")
  Thap       @map("Thấp")
}

enum LogType {
  Recognition
  Payment
  Vehicle
  Admin
  Other
}

enum SettingType {
  string
  number
  boolean
}
